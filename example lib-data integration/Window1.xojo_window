#tag WindowCode
	#tag Method, Flags = &h0
		Function findTestDataFolder() As FolderItem
		  var fld as FolderItem
		  
		  var upcount as integer = 15
		  
		  fld = App.ExecutableFile.parent
		  
		  while upcount > 0
		    
		    for each subfld as FolderItem in fld.Children
		      
		      if subfld.Name = "test_xlsx_data" and subfld.IsFolder then return subfld
		      
		    next
		    
		    fld = fld.Parent
		    upcount = upcount - 1
		    
		  wend
		  
		  return nil
		  
		  
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Function LoadTestXLSXFile() As clWorkbook
		  
		  //
		  // load the test workbook (load sheets on demand)
		  //
		  
		  if loadedWorkBook <> nil then return loadedWorkBook
		  
		  var baseFld as FolderItem = findTestDataFolder
		  
		  var fld as FolderItem
		  var debugOptions as  clXLSX_Debugging
		  
		  // Load a set of tabular sheets, use on-demand load
		  fld = baseFld.Child("test_file_2.xlsx")
		  if not fld.Exists then Return nil
		  
		  debugOptions = new clXLSX_Debugging
		  debugOptions.All_Off()
		  
		  loadedWorkBook =  new clWorkbook(fld , debugOptions, clWorkbook.LoadModes.LoadSheetOnDemand)
		  
		  return loadedWorkBook
		  
		  
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub LoadWithHeaders()
		  
		  var wb as clWorkbook = LoadTestXLSXFile()
		  
		  if wb = nil then Return
		  
		  var tbl as clDataTable = WorksheetToTable(wb, "Sales Area 2", True)
		  
		  DesktopListboxForTable1.ShowTable(tbl)
		  
		  return
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub LoadWithoutHeader()
		  
		  var wb as clWorkbook = LoadTestXLSXFile()
		  
		  if wb = nil then Return
		  
		  var tbl as clDataTable = WorksheetToTable(wb, "Sales Area 2", false)
		  
		  DesktopListboxForTable1.ShowTable(tbl)
		  
		  return
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h0
		loadedWorkBook As clWorkbook
	#tag EndProperty


#tag EndWindowCode

#tag Events Button1
	#tag Event
		Sub Pressed()
		  LoadWithoutHeader
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button2
	#tag Event
		Sub Pressed()
		  LoadWithHeaders
		  
		  
		End Sub
	#tag EndEvent
#tag EndEvents
